# --- Repository projection additions (new setup work, 2026-09-17) ---
# The frozen import pack's rules above are preserved verbatim. The rules below
# belong to this repository projection only.

# Local check output from tools/repo-check.py.
/.repo-check-output/

# Restored reference inputs must never land in ordinary Git history. Keep the
# immutable 604 reference outside this working tree (see docs/ARTIFACTS.md).
/reference-604/
/SOLARIS_604_REFERENCE_DIR/

# The frozen pack's `/Solaris-Android-Reconstruction/build-inputs/` rule was
# written for the complete handoff, where that directory held tool binaries.
# This source projection retains only its five JSON descriptors, which must stay
# tracked so the import remains byte-verifiable. Binaries there stay ignored.
!/Solaris-Android-Reconstruction/build-inputs/
/Solaris-Android-Reconstruction/build-inputs/**
!/Solaris-Android-Reconstruction/build-inputs/ui-toolchain/
!/Solaris-Android-Reconstruction/build-inputs/BUILD-INPUTS.json
!/Solaris-Android-Reconstruction/build-inputs/TOOL-PROVENANCE.json
!/Solaris-Android-Reconstruction/build-inputs/packaged-dependencies.json
!/Solaris-Android-Reconstruction/build-inputs/ui-toolchain/package.json
!/Solaris-Android-Reconstruction/build-inputs/ui-toolchain/package-lock.json

# NBR-10: host reproduction output. The wrapper writes only to its argv output
# directory and refuses an existing one, so this is latent rather than live —
# but the file provably contains an absolute local path and this repo is public.
WRAPPER-RESULT.json
candidate604.hbc
# S2R-8(d): the Sprint-02 host tools' result files carry local paths too. The
# tools also refuse an output directory inside any git work tree.
DONOR-CANDIDATE-RESULT.json
FIT-RESULT.json
PROBE-RESULT.json

# Local agent state and per-agent git worktrees. Never repository content.
/.claude/
